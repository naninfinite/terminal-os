# YOU.EXE Supabase Edge Function base URL (function root).
# Frontend calls this URL directly (GET/POST at `/`), so it should end at `/you`.
VITE_YOU_API_BASE_URL=https://<project-ref>.supabase.co/functions/v1/you

# Auth note:
# Current deployment uses verify_jwt = false, so anon key auth headers are NOT used by the frontend.
# Keep service_role keys only in Supabase Function secrets (never in frontend env files).
# VITE_YOU_API_ANON_KEY=<not-used-when-verify_jwt-false>

# CORS note (backend config):
# - Allow localhost dev origin(s) and production domain(s).
# - Allow request headers: content-type, x-you-client-key (and accept if used).
