# YOU.EXE Supabase Edge Function base URL.
# Frontend client appends `/messages`, so this should end at `/you`.
VITE_YOU_API_BASE_URL=https://<project-ref>.supabase.co/functions/v1/you

# Optional: only required if your `you` Edge Function has `verify_jwt=true`.
# Safe to expose in frontend: anon/publishable key only.
# NEVER put service_role keys in frontend env files.
VITE_YOU_API_ANON_KEY=<optional_anon_publishable_key>
